FROM nginx:alpine

# Copy UI files to nginx
COPY ui/react_frontend.html /usr/share/nginx/html/index.html
COPY ui/react_frontend.html /usr/share/nginx/html/react_frontend.html
COPY ui/edge_device_ui.html /usr/share/nginx/html/edge_device_ui.html

# Copy nginx configuration
COPY ui/nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]